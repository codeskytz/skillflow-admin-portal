# Apache config for the built single-page app on cPanel.
# Vite copies everything in public/ into dist/, so this ships with the build.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Client-side routing: anything that is not a real file or directory is
  # handed to index.html for React Router to resolve. Without this, opening or
  # refreshing /app/videos asks Apache for a directory that does not exist and
  # gets a 404.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Vite fingerprints asset filenames, so a given URL's contents never change
  # and it can be cached indefinitely.
  <FilesMatch "\.(js|css|woff2?|ttf|eot|png|jpe?g|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html is the one file whose contents change every release, and it is
  # what points at the fingerprinted bundles. Caching it would leave returning
  # visitors on the previous release until their cache expired.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # Declared after the rule above so these win.
  #
  # sw.js is NOT fingerprinted — it keeps the same URL for the life of the app,
  # and it is the file that decides what everything else caches. Serving it as
  # immutable for a year would freeze the installed app on whatever version a
  # user first got, with no way to ship a fix.
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>

  # Same reasoning, less urgently: the manifest changes only between releases
  # but must be allowed to.
  <Files "manifest.webmanifest">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_mime.c>
  # Without the right type some browsers ignore the manifest, and the install
  # option never appears.
  AddType application/manifest+json .webmanifest
</IfModule>

# Directory listings should never be served from a built app.
Options -Indexes
